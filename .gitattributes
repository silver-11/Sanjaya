# Git LFS Configuration for Model Checkpoints
# This file tells Git which files should be tracked with Git LFS
# Model checkpoint files (track with LFS)
*.pth filter=lfs diff=lfs merge=lfs -text
*.pkl filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.ckpt filter=lfs diff=lfs merge=lfs -text
*.h5 filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
# Specific model files (if you want to track specific ones)
# models/checkpoint_chunk_5_epoch_9.pth filter=lfs diff=lfs merge=lfs -text
# models/disease_sentence_model.pkl filter=lfs diff=lfs merge=lfs -text
# Text files (normal Git tracking)
*.py text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
# Auto detect text files
* text=auto
